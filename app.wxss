/* app.wxss —— 全局：撞色背景 + 粗黑描边 + 硬阴影贴纸感 + 少量动效 */

page {
  background-color: #FFD93D;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: #111111;
  font-size: 30rpx;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 背景：高饱和渐变 + 几何图形 + 噪点 ---------- */
.bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
  background: linear-gradient(168deg, #FFD93D 0%, #FF8A3D 48%, #FF4D6D 100%);
}

/* 几何色块 */
.bg::before {
  content: '';
  position: absolute;
  left: -140rpx;
  top: 160rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: #4D96FF;
  opacity: .45;
}

.bg::after {
  content: '';
  position: absolute;
  right: -180rpx;
  bottom: -120rpx;
  width: 620rpx;
  height: 620rpx;
  background: #111111;
  opacity: .09;
  transform: rotate(24deg);
  border-radius: 80rpx;
}

/* 噪点层（纯 CSS 点阵，无图片） */
.bg-dots {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: .12;
  background-image: radial-gradient(#111111 1.6rpx, transparent 1.8rpx);
  background-size: 30rpx 30rpx;
}

/* ---------- 页面容器 ---------- */
.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
}

/* ---------- 文字 ---------- */
.ink {
  color: #111111;
  font-weight: 900;
  /* 白色四向描边，做出贴纸字的粗边感 */
  text-shadow: 6rpx 6rpx 0 #FFFFFF, -6rpx 6rpx 0 #FFFFFF,
               6rpx -6rpx 0 #FFFFFF, -6rpx -6rpx 0 #FFFFFF;
}

.title {
  font-size: 92rpx;
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -2rpx;
}

.title-sm {
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.1;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
  opacity: .78;
}

/* ---------- 贴纸卡片 ---------- */
.sticker {
  background: #FFFFFF;
  border: 8rpx solid #111111;
  border-radius: 34rpx;
  box-shadow: 10rpx 10rpx 0 #111111;
}

.tilt-l {
  transform: rotate(-1.4deg);
}

.tilt-r {
  transform: rotate(1.2deg);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 24rpx;
  border: 8rpx solid #111111;
  border-radius: 52rpx;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  box-shadow: 12rpx 12rpx 0 #111111;
  transition: transform .12s ease, box-shadow .12s ease;
}

.btn-hover {
  transform: translate(8rpx, 8rpx);
  box-shadow: 4rpx 4rpx 0 #111111;
}

.btn-main {
  background: #111111;
  color: #FFE353;
}

.btn-pop {
  background: #FF4D6D;
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #111111;
  font-size: 36rpx;
  padding: 26rpx 24rpx;
}

.btn-off {
  background: #DCDCDC;
  color: #8C8C8C;
  box-shadow: 12rpx 12rpx 0 #A5A5A5;
}

.btn + .btn {
  margin-top: 24rpx;
}

/* ---------- 遮罩 / 弹窗 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 99;
  background: rgba(17, 17, 17, .55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
}

.mask-card {
  width: 100%;
  padding: 48rpx 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.mask-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.mask-text {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.mask-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.mask-link {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #666666;
  text-decoration: underline;
}

/* ---------- 动效（只用 transform / opacity，走 GPU） ---------- */
@keyframes shake {

  0%, 100% {
    transform: rotate(-1.5deg) translateY(0);
  }

  50% {
    transform: rotate(1.5deg) translateY(-6rpx);
  }
}

.shake {
  animation: shake 1.6s ease-in-out infinite;
}

@keyframes pop-in {
  0% {
    transform: scale(.6) rotate(-8deg);
    opacity: 0;
  }

  70% {
    transform: scale(1.08) rotate(2deg);
    opacity: 1;
  }

  100% {
    transform: scale(1) rotate(-1deg);
    opacity: 1;
  }
}

.pop {
  animation: pop-in .52s cubic-bezier(.2, 1.4, .4, 1) both;
}

@keyframes floaty {

  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-14rpx);
  }
}

.floaty {
  animation: floaty 2.4s ease-in-out infinite;
}

@keyframes spin-emoji {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

.spin-emoji {
  display: inline-block;
  animation: spin-emoji 1.1s linear infinite;
}
