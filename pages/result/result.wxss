/* 结果页样式：结果卡弹跳出现，信息极简 */
.head {
  padding: 6rpx 8rpx 0;
}

.card {
  margin-top: 40rpx;
  padding: 46rpx 36rpx 40rpx;
  text-align: center;
  transform-origin: center center;
}

.card-emoji {
  font-size: 120rpx;
  line-height: 1;
}

.shop-name {
  margin-top: 20rpx;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.meta-row {
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
}

.meta-pill {
  margin: 0 10rpx;
  padding: 14rpx 28rpx;
  font-size: 30rpx;
  font-weight: 900;
  background: #FFE353;
  border: 6rpx solid #111111;
  border-radius: 30rpx;
}

.addr {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 6rpx dashed #DDDDDD;
  font-size: 26rpx;
  line-height: 1.6;
  color: #555555;
  word-break: break-all;
}

.bottom {
  padding: 10rpx 8rpx 0;
}

.foot-note {
  margin-top: 26rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #333333;
}
