/* 转盘组件样式：粗黑描边 + 硬阴影 + 贴纸感 */
.wheel-wrap {
  position: relative;
  width: 620rpx;
  height: 620rpx;
  margin: 24rpx auto 0;
}

/* 匀速旋转的循环动画（阶段二使用） */
@keyframes wheel-loop {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.disc {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 10rpx solid #111111;
  box-sizing: border-box;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 12rpx 12rpx 0 #111111;
  /* transform / transition / animation 由 JS 控制，避免 WXSS 与 setData 抢样式 */
  will-change: transform;
}

.sectors {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.label {
  position: absolute;
  left: 50%;
  top: 0;
  width: 156rpx;
  height: 50%;
  margin-left: -78rpx;
  /* 旋转轴放在圆心上，绕圆心转才落在对应扇区 */
  transform-origin: center bottom;
}

.label-inner {
  position: absolute;
  left: 0;
  top: 34rpx;
  width: 100%;
  text-align: center;
}

.label-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.label-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.15;
  word-break: break-all;
  /* 扇区底色深浅不一，用白描边保证可读 */
  text-shadow: 2rpx 2rpx 0 #FFFFFF, -2rpx 2rpx 0 #FFFFFF,
               2rpx -2rpx 0 #FFFFFF, -2rpx -2rpx 0 #FFFFFF;
}

.hub {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 158rpx;
  height: 158rpx;
  margin: -79rpx 0 0 -79rpx;
  border-radius: 50%;
  border: 8rpx solid #111111;
  background: #FFE353;
  box-shadow: 0 0 0 8rpx #FFFFFF inset;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.hub-num {
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.hub-sub {
  font-size: 22rpx;
  font-weight: 700;
  color: #444444;
}

/* 指针：白色填充 + 黑色描边，纯 border 三角形 */
.pointer {
  position: absolute;
  left: 50%;
  top: -24rpx;
  width: 72rpx;
  height: 66rpx;
  margin-left: -36rpx;
  z-index: 5;
}

.pointer::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  border-left: 36rpx solid transparent;
  border-right: 36rpx solid transparent;
  border-top: 66rpx solid #111111;
}

.pointer::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 0;
  width: 0;
  height: 0;
  border-left: 27rpx solid transparent;
  border-right: 27rpx solid transparent;
  border-top: 50rpx solid #FFFFFF;
}
